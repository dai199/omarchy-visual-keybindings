#!/usr/bin/env python3
"""Convert Omarchy's printable keybinding list to JSON."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

_SCRIPTS = Path(__file__).resolve().parent
if str(_SCRIPTS) not in sys.path:
    sys.path.insert(0, str(_SCRIPTS))
from key_identity import MODIFIER_ORDER, normalize_shortcut
from user_bindings import command_for, origin_for, parse_user_bindings

MODIFIERS = MODIFIER_ORDER
ROW_PATTERN = re.compile(r"^\s*(.*?)\s+→\s+(.+?)\s*$")


def parse_bindings(output: str, user_lua: str = "") -> list[dict[str, object]]:
    bindings: list[dict[str, object]] = []
    user_binds = parse_user_bindings(user_lua)

    for line in output.splitlines():
        match = ROW_PATTERN.match(line)
        if not match:
            continue

        shortcut_text, description = match.groups()
        shortcut = normalize_shortcut(shortcut_text)
        if not shortcut:
            continue
        parts = shortcut.split(" + ")
        key = parts[-1]
        modifiers = [part for part in parts[:-1] if part in MODIFIERS]
        if not key or key in MODIFIERS:
            continue
        bindings.append(
            {
                "shortcut": shortcut,
                "modifiers": modifiers,
                "key": str(key),
                "description": description.strip(),
                "origin": origin_for(shortcut, user_binds),
                "command": command_for(shortcut, user_binds),
            }
        )

    return bindings


def read_source(input_path: Path | None) -> str:
    if input_path:
        return input_path.read_text(encoding="utf-8")

    result = subprocess.run(
        ["omarchy", "menu", "keybindings", "--print"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0 and not result.stdout:
        raise RuntimeError(result.stderr.strip() or "Unable to read keybindings")
    return result.stdout


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", type=Path, help="Parse a saved command output")
    parser.add_argument(
        "--user-config",
        type=Path,
        default=Path.home() / ".config" / "hypr" / "bindings.lua",
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args()

    try:
        source = read_source(args.input)
        user_lua = ""
        if args.user_config and args.user_config.exists():
            user_lua = args.user_config.read_text(encoding="utf-8")
        json.dump(parse_bindings(source, user_lua), sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    except (OSError, RuntimeError) as error:
        print(json.dumps({"error": str(error)}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
